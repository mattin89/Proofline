# Optional server-side live research. Never expose this value in browser code.
TAVILY_API=

# Optional independent retrieval cross-check. It is used only when the user
# explicitly selects Exa cross-validation for a live research run.
EXA_API=

# Optional. Increases the GitHub Repository Search rate limit used by trend
# discovery. Use a least-privilege token; never commit the populated value.
GITHUB_TOKEN=

# Optional local port. Proofline binds to 127.0.0.1 only.
PORT=4173
